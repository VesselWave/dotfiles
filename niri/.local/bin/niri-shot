#!/bin/bash

SAVE_DIR="$HOME/Pictures/Screenshots"
mkdir -p "$SAVE_DIR"
TIMESTAMP=$(date +'%Y-%m-%d-%H%M%S')
FILE="$SAVE_DIR/screenshot_$TIMESTAMP.png"

if [ "$1" = "--full" ]; then
    grim - | tee "$FILE" | wl-copy --type image/png
else
    GEOM=$(slurp)
    [ -z "$GEOM" ] && exit 1
    grim -g "$GEOM" - | tee "$FILE" | wl-copy --type image/png
fi

notify-send "Screenshot Captured" "Saved and copied to clipboard" \
    -i "$FILE" \
    --action="open=Open Image" \
    --action="folder=Open Folder" | xargs -I {} bash -c "case {} in 'open') xdg-open '$FILE' ;; 'folder') xdg-open '$SAVE_DIR' ;; esac"
